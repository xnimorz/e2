  "description": "ESLint rules for e2: catch effects that are built and never run",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "e2",
    "typescript"
  ],
  "license": "MIT",
  "author": "Nikita Mostovoy <xnimor@ya.ru>",
  "homepage": "https://xnimorz.github.io/e2/effects.html#footgun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xnimorz/e2.git",
    "directory": "packages/eslint-plugin-e2"
  },
  "bugs": "https://github.com/xnimorz/e2/issues",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
